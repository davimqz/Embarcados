# Modelo de configuração do backend.
# Copie para .env (ignorado pelo git) e ajuste:
#   cp .env.example .env

# Broker MQTT. Em desenvolvimento, o do `npm run broker`; na apresentação, o Mosquitto do notebook.
MQTT_URL=mqtt://localhost:1883

# Número do grupo: forma os tópicos grupo<N>/...
GRUPO=3

# Porta do broker de desenvolvimento (`npm run broker`).
BROKER_PORTA=1883
